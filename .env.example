# Salin ke .env lalu ganti semua nilai "change-me".
#   cp .env.example .env

# --- Docker Compose (database & redis lokal) ---
POSTGRES_USER=auth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auth
POSTGRES_HOST_PORT=5440
REDIS_HOST_PORT=6390
# Port host untuk service app di docker-compose.
APP_HOST_PORT=8080

# --- Aplikasi ---
PORT=8080
# Dipakai saat menjalankan `go run` langsung di host. Di docker-compose nilai ini
# dioverride agar menunjuk ke service "postgres" dan "redis".
DATABASE_URL=postgres://auth:change-me@localhost:5440/auth?sslmode=disable
# Kosongkan REDIS_URL untuk memakai cache in-memory (single instance).
REDIS_URL=redis://localhost:6390/0

# Minimal 32 karakter. Buat dengan: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-random-secret-of-32-chars-or-more
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Rate limit login: maksimal N percobaan per (IP + email) dalam satu window.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW=15m

# Daftar IP/CIDR dipisah koma. Kosong = semua IP diizinkan.
# Contoh: IP_WHITELIST=127.0.0.1,10.0.0.0/8,::1
IP_WHITELIST=
# true hanya jika service berada di belakang reverse proxy tepercaya.
TRUST_PROXY=false

# Kode 2FA simulasi yang wajib dikirim di header X-2FA-Code untuk endpoint sensitif.
TWO_FA_CODE=change-me

PERMISSION_CACHE_TTL=5m

# Integration test (opsional): database khusus test.
# TEST_DATABASE_URL=postgres://auth:change-me@localhost:5440/auth?sslmode=disable
# TEST_REDIS_URL=redis://localhost:6390/1
